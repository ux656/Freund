# ── الاتصال بقاعدة البيانات (اختياري) ──
# بدون هذه المتغيرات يعمل الداشبورد بالذاكرة فقط (نفس السلوك القديم).

# يحدد السائق تلقائياً من صيغة الرابط:
#   postgres://  |  postgresql://  → PostgreSQL  (حزمة pg)
#   mysql://                       → MySQL/MariaDB (حزمة mysql2)
#   mongodb://  |  mongodb+srv://  → MongoDB      (حزمة mongodb)
#   sqlite:  أو ملف .db           → SQLite       (مدمج في Node 22.5+)
DATABASE_URL=

# تثبيت السائق يدوياً: memory | sqlite | postgres | mysql | mongodb
DB_DRIVER=

# اسم قاعدة البيانات (اختياري، يُقرأ من الرابط افتراضياً)
DB_NAME=

# مسار ملف SQLite عندما لا يوجد DATABASE_URL (افتراضي .data/freund.db)
DB_SQLITE_PATH=.data/freund.db

# إيقاف نظام قاعدة البيانات بالكامل
DB_DISABLE=0

# ── الاتصال بخدمة البوت ──
BOT_API_URL=
BOT_API_TOKEN=

# ── أصول مسموحة (مفصولة بفاصلة) ──
APP_ALLOWED_ORIGINS=
